# Everything that is true only on Explorer. Read with `source` by submit.sh
# and by both job scripts, so the job scripts contain no paths.
PARTITION=courses
ACCOUNT=binf6610.202710
USER=${USER:-$(id -un)}                      # a job may start without $USER set
SAMPLESHEET=/courses/BINF6610.202710/data/samplesheet-variant8.csv
PIPELINE_DIR=${HOME}/binf6610-pipeline       # where you cloned the repository
RUN_ROOT=/scratch/${USER}/w3-run             # week 3: a new folder, so every stage runs in the image
JAVA_MEM=6g                                  # Java heap for the JVM-based stages
SIF=/scratch/${USER}/containers/variant-call.sif   # the image, pulled by slurm/pull.sbatch
