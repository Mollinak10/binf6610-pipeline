            --filter-expression "ReadPosRankSum < -8.0" --filter-name "ReadPosRankSum-8"
        gatk --java-options '-Xmx6400m' SelectVariants -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/joint/cohort.vcf.gz \
            --select-type-to-include INDEL --select-type-to-include MIXED -O work/filter/indels.vcf.gz
        gatk --java-options '-Xmx6400m' VariantFiltration -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa -V work/filter/indels.vcf.gz \
